<?php
// Template only. Live deploy uses inc/db.php, which loads ../config.local.php.
// Copy config.local.php.example → config.local.php and set GearHost credentials.

const APP_COMPANY = 'Your Company Name';   // shown in the app header and on PDF reports

// --- Option A: config.local.php in project root ---
// return [
//     'db' => [
//         'server'   => 'den1.mssql8.gear.host',
//         'database' => 'infos',
//         'user'     => 'infos',
//         'password' => 'YOUR_GEARHOST_PASSWORD',
//     ],
// ];

$server   = "DESKTOP-KPBMUH3";          // local: DESKTOP-KPBMUH3 | GearHost: den1.mssqlN.gear.host
$database = "YOUR_DATABASE";            // GearHost: same name as the DB (often also the username)
$user     = "support_app";
$password = "YOUR_PASSWORD";

date_default_timezone_set('Asia/Dubai');

try {
    $conn = new PDO("sqlsrv:Server=$server;Database=$database;TrustServerCertificate=1", $user, $password);
    $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $conn->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
} catch (PDOException $e) {
    error_log("Connection failed: " . $e->getMessage());
    die('Database connection error');
}
