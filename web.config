<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />
        <staticContent>
            <!-- self-hosted fonts (assets/fonts); older IIS versions do not know .woff2 -->
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        <security>
            <requestFiltering>
                <!-- includes (incl. db.php credentials), SQL scripts and the repo are never served -->
                <hiddenSegments>
                    <add segment="inc" />
                    <add segment="sql" />
                    <add segment=".git" />
                </hiddenSegments>
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".example" allowed="false" />
                </fileExtensions>
                <denyUrlSequences>
                    <add sequence="config.local.php" />
                </denyUrlSequences>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
